// One empty module per Lite feature. Installing lite_remove_<FEATURE> keeps the listed
// modules out of the image through `overrides` (PRODUCT_PACKAGES_REMOVE is not implemented
// by this build system). Mirrors LITE_MODULES_* in ../features.mk; keep the two in sync.

prebuilt_etc {
    name: "lite_remove_GOOGLE_APP",
    src: "empty",
    filename: "lite_remove_GOOGLE_APP",
    sub_dir: "lite",
    overrides: ["Velvet", "VelvetTitan"],
}

prebuilt_etc {
    name: "lite_remove_GOOGLE_SPEECH",
    src: "empty",
    filename: "lite_remove_GOOGLE_SPEECH",
    sub_dir: "lite",
    overrides: ["SpeechServicesByGoogle"],
}

