# System properties for gauguin Lite. Added to PRODUCT_PRODUCT_PROPERTIES by lite.mk.

# Report the bootloader as locked and verified boot as green. Apps that only read these
# properties stop warning; this does NOT affect hardware-backed Play Integrity (TEE).
ro.boot.verifiedbootstate=green
ro.boot.vbmeta.device_state=locked
ro.boot.flash.locked=1
vendor.boot.vbmeta.device_state=locked
ro.secureboot.lockstate=locked

# Self-hosted OTA: point the in-ROM Updater at your own server (see scripts/make-ota-json.py).
# Replace this with where you host gauguin.json. Remove the line entirely to keep the default
# LineageOS endpoint (which has no builds for a self-built ROM, so Updater just shows "up to date").
lineage.updater.uri=https://YOUR-OTA-HOST/gauguin/gauguin.json


# Release ART and no CheckJNI: eng defaults (libartd, ro.kernel.android.checkjni=1) make every app slow
dalvik.vm.checkjni=false
persist.sys.dalvik.vm.lib.2=libart.so


# Video thumbnails on the software AVC/HEVC decoder: c2.qti.* output buffers can't be wrapped by FrameDecoder's async path and mediaserver segfaults
media.stagefright.thumbnail.prefer_hw_codecs=false

# Expose the aux cameras (ultrawide/macro/depth ids) to every app: with this prop empty, Camera.shouldExposeAuxCamera()
# falls back to the caller's own package name. A list would hit the 91-byte property limit.
vendor.camera.aux.packagelist=
