<?xml version="1.0" encoding="utf-8"?>
<!-- The ROM ships the signed release (dev.opencamera.app); dev.opencamera.app.dev is for test builds. -->
<config>
    <install-in-user-type package="dev.opencamera.app">
        <install-in user-type="FULL" />
        <install-in user-type="PROFILE" />
        <do-not-install-in user-type="android.os.usertype.profile.CLONE" />
    </install-in-user-type>
    <install-in-user-type package="dev.opencamera.app.dev">
        <install-in user-type="FULL" />
        <install-in user-type="PROFILE" />
        <do-not-install-in user-type="android.os.usertype.profile.CLONE" />
    </install-in-user-type>
</config>